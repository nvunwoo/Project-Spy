{
  "name": "project-spy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PROJECT SPY Phase 0B fixture client and deterministic rules core",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
