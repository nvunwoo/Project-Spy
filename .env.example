# Public browser configuration. Values prefixed with NEXT_PUBLIC_ are bundled
# into the client and must never contain passwords, secret keys, or tokens.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_ENV=development

# Server-only configuration. Populate these in local .env.local and in the
# hosting provider's secret store; never commit their real values.
DATABASE_URL=
SUPABASE_SECRET_KEY=
INVITE_TOKEN_PEPPER=

